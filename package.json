{
  "name": "@koalanis/fallout-checklist",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "npm run generate:data && astro dev",
    "build": "npm run generate:data && astro build",
    "preview": "astro preview",
    "generate:data": "node src/scripts/generateData.cjs",
    "astro": "astro",
